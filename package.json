{
    "name": "cap01-website",
    "version": "0.1.0",
    "private": true,
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "type": "module",
    "scripts": {
        "dev": "astro dev --port 4321",
        "build": "astro build",
        "start": "astro preview --port 4321",
        "lint": "typescript check && astro check && prettier --check 'src/**/*.astro'",
        "lint:fix": "typescript fix && prettier --write 'src/**/*.astro'",
        "test": "vitest run"
    },
    "dependencies": {
        "astro": "7.3.2"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.10",
        "@jterrazz/test": "14.3.0",
        "@jterrazz/typescript": "9.3.0",
        "@types/node": "24.13.4",
        "prettier": "3.9.6",
        "prettier-plugin-astro": "1.0.0",
        "vitest": "4.1.11"
    },
    "engines": {
        "node": ">=24 <25"
    }
}
